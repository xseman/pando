#!/bin/sh
# A gh for github.tape: it answers from the canned files beside it, so the
# GitHub view has a repository to list without a remote or the network.
d=$(dirname "$0")
case "$1 $2" in
"api user") echo mara ;;
"api -X") ;;                                   # mark read, Mark as Done
"api "*) cat "$d/notifications.json" ;;
"pr list")
	case "$*" in
	*review-requested*) cat "$d/pr-review.json" ;;
	*--assignee* | *--author*) echo '[]' ;; # empty, so All Open has the rows
	*) cat "$d/pr-list.json" ;;
	esac ;;
"issue list")
	case "$*" in
	*--author*) echo '[]' ;;
	*) cat "$d/issue-list.json" ;;
	esac ;;
"pr view" | "issue view") cat "$d/$1-$3.json" ;;
"pr diff") cat "$d/pr-$3.diff" ;;
"pr checkout") # in the new worktree, #8 only: its branch with its commit
	git checkout -q -b "$5" && git apply "$d/pr-$3.diff" && git add -A &&
		git commit -qm "Add Discount (#$3)" ;;
*) echo "gh (demo): $* is not canned" >&2; exit 1 ;;
esac
