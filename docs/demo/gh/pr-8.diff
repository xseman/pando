+package store
+
+import "testing"
+
+func TestDiscount(t *testing.T) {
+	s := New()
+	s.Add("espresso", 250)
+	s.Add("cortado", 300)
+
+	for percent, want := range map[int]int{0: 550, 10: 495, 50: 275, 100: 0} {
+		if got := s.Discount(percent); got != want {
+			t.Errorf("Discount(%d) = %d, want %d", percent, got, want)
+		}
+	}
+}
